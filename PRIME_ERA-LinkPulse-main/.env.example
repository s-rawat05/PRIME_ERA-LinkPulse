# Copy to .env.local for local development. Never commit real values.

# --- Database ---------------------------------------------------------------
# Production: a Postgres connection string (Neon pooled URL recommended), e.g.
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/linkpulse?sslmode=require
# Local zero-install alternative: an embedded PGlite database stored in ./.data/pglite
DATABASE_URL=pglite:./.data/pglite
# Max connections per serverless instance when using Postgres
DATABASE_POOL_MAX=5

# --- App ----------------------------------------------------------------------
# Public origin used to build short links and QR codes (no trailing slash)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# 32+ random characters. Signs the daily visitor-hash salt and IP hashes. Required in production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-64-hex-characters
# Protects /api/cron/rollup (Vercel Cron sends it as a Bearer token)
CRON_SECRET=replace-with-a-random-string

# --- Optional integrations ----------------------------------------------------
# Upstash Redis: shared link cache + sliding-window rate limits. Without it the app reads links
# from Postgres on every redirect and uses a Postgres-backed rate limiter (both correct, slower).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Override cache selection: redis | memory | none (memory is single-process only; never use in serverless)
# CACHE_DRIVER=

# Google Safe Browsing v4 key. Without it, links are checked against the domain blocklist only
# and are honestly recorded as "not_scanned".
GOOGLE_SAFE_BROWSING_API_KEY=

# --- Scripts --------------------------------------------------------------------
# Used by `npm run admin:create` when creating a new admin (otherwise a random password is printed once)
# ADMIN_PASSWORD=
# Used by `npm run db:seed` for the demo user (otherwise a random password is printed once)
# SEED_PASSWORD=
